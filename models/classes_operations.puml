@startuml
!pragma layout smetana
skinparam dpi 160
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam linetype ortho
hide empty members
title Пакет ru.mirea.furniture
class Warehouse {
  -customers : Map<String, Customer>
  -products : Map<String, Product>
  -stocks : Map<String, Stock>
  -reservations : List<Reservation>
  -request : Request
  --
  +customers() : Map<String, Customer>
  +products() : Map<String, Product>
  +stocks() : Map<String, Stock>
  +reservations() : List<Reservation>
  +request() : Request
  +checkAvailability(List<RequestLine>) : List<Shortage>
  +hasReservation() : boolean
  +reserveAll() : OperationResult
  +cancel(String, String) : OperationResult
}
interface Operation {
  --
  +apply() : OperationResult
}
abstract class AbstractOperation {
  -warehouse : Warehouse
  --
  #warehouse() : Warehouse
  +apply() : OperationResult
  #execute() : OperationResult
}
class ReserveOperation {
  --
  #execute() : OperationResult
}
class CancelOperation {
  -requestId : String
  -reason : String
  --
  #execute() : OperationResult
}
Operation <|.. AbstractOperation
AbstractOperation <|-- ReserveOperation
AbstractOperation <|-- CancelOperation
AbstractOperation "0..*" --> "1" Warehouse

note bottom of AbstractOperation
  apply(): общий перевод ошибки проверки
  IllegalArgumentException в Rejected
end note

@enduml
