<mxfile host="app.diagrams.net"><diagram name="Проверка доступности"><mxGraphModel page="1" pageWidth="1060" pageHeight="1440"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="Начало" style="shape=ellipse;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffffff;strokeColor=#233e52;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="20" width="200" height="55" /></mxCell><mxCell id="input" value="Ввод строк, остатков и резервов&lt;br&gt;Дефицит = []" style="shape=parallelogram;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffffff;strokeColor=#233e52;" vertex="1" parent="1"><mxGeometry as="geometry" x="260" y="110" width="400" height="65" /></mxCell><mxCell id="lines" value="Есть ещё строки?" style="shape=rhombus;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffffff;strokeColor=#233e52;" vertex="1" parent="1"><mxGeometry as="geometry" x="320" y="220" width="280" height="90" /></mxCell><mxCell id="line" value="Взять следующую строку" style="shape=rectangle;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffffff;strokeColor=#233e52;" vertex="1" parent="1"><mxGeometry as="geometry" x="280" y="350" width="360" height="55" /></mxCell><mxCell id="zero" value="Резерв = 0&lt;br&gt;Начать просмотр резервов" style="shape=rectangle;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffffff;strokeColor=#233e52;" vertex="1" parent="1"><mxGeometry as="geometry" x="280" y="450" width="360" height="55" /></mxCell><mxCell id="more" value="Есть ещё резервы?" style="shape=rhombus;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffffff;strokeColor=#233e52;" vertex="1" parent="1"><mxGeometry as="geometry" x="320" y="550" width="280" height="90" /></mxCell><mxCell id="next" value="Взять следующий резерв" style="shape=rectangle;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffffff;strokeColor=#233e52;" vertex="1" parent="1"><mxGeometry as="geometry" x="280" y="690" width="360" height="55" /></mxCell><mxCell id="match" value="Тот же товар&lt;br&gt;и активен?" style="shape=rhomb