@startuml
!pragma layout smetana
skinparam dpi 160
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam linetype ortho
hide empty members
title Пакет ru.mirea.furniture
class Customer {
  -id : String
  -name : String
  --
  +id() : String
  +name() : String
}
class Request {
  -id : String
  -customerId : String
  -confirmed : boolean
  -agreedTotal : String
  -lines : List<RequestLine>
  -cancelled : boolean
  -cancellationReason : String
  --
  +id() : String
  +customerId() : String
  +confirmed() : boolean
  +agreedTotal() : String
  +lines() : List<RequestLine>
  +cancelled() : boolean
  +cancellationReason() : String
  +cancel(String) : void
  +validate(Map<String, Customer>, Map<String, Product>) : String
  +mergedLines() : List<RequestLine>
  +calculateTotal(List<RequestLine>, Map<String, Product>) : BigDecimal
}
class RequestLine {
  -productId : String
  -quantity : BigDecimal
  --
  +productId() : String
  +quantity() : BigDecimal
}
class Product {
  -id : String
  -name : String
  -price : BigDecimal
  --
  +id() : String
  +name() : String
  +price() : BigDecimal
}
class Stock {
  -productId : String
  -quantity : BigDecimal
  --
  +productId() : String
  +quantity() : BigDecimal
}
class Reservation {
  -id : String
  -requestId : String
  -productId : String
  -quantity : BigDecimal
  -active : boolean
  --
  +id() : String
  +requestId() : String
  +productId() : String
  +quantity() : BigDecimal
  +active() : boolean
  +release() : void
}
class Warehouse {
  -customers : Map<String, Customer>
  -products : Map<String, Product>
  -stocks : Map<String, Stock>
  -reservations : List<Reservation>
  -request : Request
  --
  +customers() : Map<String, Customer>
  +products() : Map<String, Product>
  +stocks() : Map<String, Stock>
  +reservations() : List<Reservation>
  +request() : Request
  +checkAvailability(List<RequestLine>) : List<Shortage>
  +hasReservation() : boolean
  +reserveAll() : OperationResult
  +cancel(String, String) : OperationResult
}
interface Operation {
  --
  +apply() : OperationResult
}
abstract class AbstractOperation {
  -warehouse : Warehouse
  --
  #warehouse() : Warehouse
  +apply() : OperationResult
  #execute() : OperationResult
}
class ReserveOperation {
  --
  #execute() : OperationResult
}
class CancelOperation {
  -requestId : String
  -reason : String
  --
  #execute() : OperationResult
}
class Main {
  --
  +{static} load(Map<String, Object>) : Warehouse
  +{static} process(Map<String, Object>) : Map<String, Object>
  +{static} main(String[]) : void
}
class Json {
  -source : String
  -offset : int
  --
  +{static} parse(String) : Object
  +{static} stringify(Object) : String
}

Customer "1" -- "0..*" Request : customerId
Request "1" *-- "0..*" RequestLine : lines
RequestLine "0..*" --> "1" Product : productId
Product "1" -- "0..1" Stock : productId
Request "1" -- "0..*" Reservation : requestId
Product "1" -- "0..*" Reservation : productId
Warehouse "1" o-- "0..*" Customer : customers
Warehouse "1" o-- "0..*" Product : products
Warehouse "1" o-- "0..*" Stock : stocks
Warehouse "1" o-- "0..*" Reservation : reservations
Warehouse "1" --> "1" Request : request
Operation <|.. AbstractOperation
AbstractOperation <|-- ReserveOperation
AbstractOperation <|-- CancelOperation
AbstractOperation "0..*" --> "1" Warehouse
Main ..> Operation : apply
Main ..> Json : parse / stringify
Main ..> Warehouse : load

interface OperationResult <<sealed>>
class "OperationResult.Rejected" as Rejected <<record>> {
  -reason : String
  -shortages : List<Shortage>
  -total : String
}
class "OperationResult.AwaitingConfirmation" as AwaitingConfirmation <<record>> {
  -total : String
}
class "OperationResult.Reserved" as Reserved <<record>> {
  -requestId : String
  -total : String
}
class "OperationResult.Cancelled" as Cancelled <<record>> {
  -requestId : String
  -reason : String
  -releasedReservations : int
}
class Shortage <<record>> {
  -productId : String
  -missing : BigDecimal
}
class ResultJson {
  +{static} toJson(OperationResult) : Map<String, Object>
}
OperationResult <|.. Rejected
OperationResult <|.. AwaitingConfirmation
OperationResult <|.. Reserved
OperationResult <|.. Cancelled
Rejected "1" *-- "0..*" Shortage
Operation ..> OperationResult : result
Warehouse ..> OperationResult
Main ..> ResultJson : serialize
ResultJson ..> OperationResult

@enduml
