mn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent><bpmn:task id="reserve" name="Зарезервировать все позиции"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task><bpmn:task id="receive" name="Принять заказ к комплектации"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:task><bpmn:endEvent id="endok" name="Заказ с резервом"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="register" /><bpmn:sequenceFlow id="Flow_1" sourceRef="register" targetRef="validate" /><bpmn:sequenceFlow id="Flow_2" sourceRef="validate" targetRef="valid" /><bpmn:sequenceFlow id="Flow_3" sourceRef="valid" targetRef="endbad" name="нет" /><bpmn:sequenceFlow id="Flow_4" sourceRef="valid" targetRef="availability" name="да"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">request_valid</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_5" sourceRef="availability" targetRef="available" /><bpmn:sequenceFlow id="Flow_6" sourceRef="available" targetRef="notify" name="нет" /><bpmn:sequenceFlow id="Flow_7" sourceRef="notify" targetRef="endshort" /><bpmn:sequenceFlow id="Flow_8" sourceRef="available" targetRef="price" name="да"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">all_available</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_9" sourceRef="price" targetRef="send" /><bpmn:sequenceFlow id="Flow_10" sourceRef="send" targetRef="confirm" /><bpmn:sequenceFlow id="Flow_11" sourceRef="confirm" targetRef="confirmed" /><bpmn:sequenceFlow id="Flow_12" sourceRef="confirmed" targetRef="endcancel" name="нет" /><bpmn:sequenceFlow id="Flow_13" sourceRef="confirmed" targetRef="reserve" name="да"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customer_confirmed</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_14" sourceRef="reserve" targetRef="receive" /><bpmn:sequenceFlow i